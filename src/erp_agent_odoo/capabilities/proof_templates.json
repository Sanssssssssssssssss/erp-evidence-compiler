  "shared_nodes": [
    {
      "id": "portfolio_plan_valid",
      "observation": "Within the requested review scope, check the candidate proposal's applicable demand, stock, purchase, manufacturing, date, tier, margin, route, consolidation, BOM and capacity constraints. If the original objective requires covering all customer requests, compare the source request set with all proposed actions and detect omitted or duplicate requests, not only incorrect proposed targets. Do not expand an explicitly partial review to unrelated business. Candidate feasibility and observed cost do not prove global optimality. If the requested review requires optimality and the materials lack sufficient comparison or bound evidence, report that missing evidence; do not search for a replacement plan.",
      "resolver": "deterministic_supply_graph",
      "objective_kinds": ["constraint_only", "min_new_spend", "capacity_preservation", "vendor_consolidation", "repair_plan"]
    },
    {
      "id": "lineage_closure_valid",
      "observation": "Every proposed SO, PO and MO belongs to one proposal graph; finished POs link to SOs, finished MOs link to SOs, and component POs/MOs link to consuming MOs with quantity closure.",
      "resolver": "deterministic_lineage_graph"
    },
    {
      "id": "supply_plan_released_checkpoint",
      "observation": "All SO/PO/MO release actions and action-specific release postconditions named by the DAG succeeded against the same bound proposal, snapshot and policy; this is a post-action checkpoint, not a planning claim.",
      "resolver": "odoo_snapshot",
      "established_by_action_kinds": [
        "sale.order.action_confirm",
        "purchase.order.button_confirm",
        "mrp.production.action_confirm"
      ]
    }
  ],
  "templates": [
    {
      "id": "sales_order_disposition.v1",
      "applies_when": "Use when the admitted policy authorizes accepting some customer requests and rejecting, cancelling or excluding others according to eligibility conditions. Apply to both confirmations and cancellations in that screening workflow, even if the proposed decision is wrong. Budget caps, quantities and deadlines alone do not establish a screening workflow: constraints on fulfilling every order belong to sales_order_release.v1. Neither a Manager stage label nor a suspected violation supplies missing authority to reject orders.",
      "executor_status": "planned",
      "protects": ["sale.order.action_confirm", "sale.order.action_cancel"],
      "applicable_stages": ["confirm", "release", "cancel"],
      "required_payload_fields": ["state", "customer_ref", "product_code", "quantity", "price_unit", "commitment_days"],
      "decision": "ALL_APPLICABLE",
      "checks": [
        {
          "id": "target_is_unique_fresh_reviewable_so",
          "applicable_stages": ["confirm", "release", "cancel"],
          "observation": "The exact task sale.order exists once and its identity, state, write_date and relevant line fingerprint equal the admitted snapshot.",
          "resolver": "odoo_snapshot"
        },
        {
          "id": "request_identity_matches_order",
          "applicable_stages": ["confirm", "release", "cancel"],
          "observation": "Customer, product, quantity and task reference match the admitted task request. Price and deadline are checked separately.",
          "resolver": "deterministic_field_match"
        },
        {
          "id": "acceptance_policy_is_admitted",
          "applicable_stages": ["confirm", "release", "cancel"],
          "observation": "The active predicate ids and parameters come from the registered policy version, not from the action proposal.",
          "resolver": "registered_policy"
        },
        {
          "id": "acceptance_predicates_match_requested_action",
          "applicable_stages": ["confirm", "release", "cancel"],
          "observation": "Evaluate every predicate enabled by the registered family. Confirm requires all active predicates true; cancel/skip requires at least one active predicate false. Stable types are budget_covers_list, quantity_range and minimum_lead_days; absent predicates are not invented.",
          "resolver": "deterministic_arithmetic"
        },
        {
          "id": "proposal_matches_policy_outcome",
          "applicable_stages": ["confirm", "release", "cancel"],
          "observation": "For this action's target requests, the proposed action matches their reviewed eligibility: confirm passing requests, cancel failing seeded drafts, and do not create failing prompt-only requests. Whole-task coverage belongs to the shared portfolio check, not this local check.",
          "resolver": "deterministic_set_comparison"
        },
        {
          "id": "confirm_payload_and_supply_are_valid",
          "applicable_stages": ["confirm", "release"],
          "observation": "The draft quotation passes Odoo's native confirmation check; commercial fields and commitment date match policy; and the confirmed subset is supported by shared portfolio_plan_valid and lineage_closure_valid.",
          "resolver": "odoo_native_transition"
        },
        {
          "id": "cancel_target_is_unlocked_and_scope_exact",
          "applicable_stages": ["cancel"],
          "observation": "The target is not locked and cancellation includes only failing seeded task orders; supply feasibility is not a cancellation prerequisite.",
          "resolver": "odoo_native_transition"
        }
      ],
      "requires_shared": {"confirm": ["portfolio_plan_valid", "lineage_closure_valid"], "release": ["portfolio_plan_valid", "lineage_closure_valid"], "cancel": []}
    },
    {
      "id": "sales_order_release.v1",
      "applies_when": "Use when the admitted policy requires fulfilling the customer orders rather than selecting which requests to accept. Budget, price, quantity, margin and delivery constraints remain review obligations under this template; violating them does not turn firm demand into an accept/reject workflow. A requirement to cover every order is not waived by words such as retained orders. If the policy instead authorizes rejecting or excluding requests on eligibility grounds, use sales_order_disposition.v1. Select from policy, not the Manager stage label or whether the proposed confirmation will pass review.",
      "executor_status": "planned",
      "protects": ["sale.order.action_confirm"],
      "applicable_stages": ["confirm", "release"],
      "required_payload_fields": ["state", "customer_ref", "product_code", "quantity", "price_unit", "commitment_days"],
      "decision": "ALL_APPLICABLE",
      "checks": [
        {
          "id": "target_is_unique_fresh_draft_so",
          "observation": "The quotation exists once, remains draft/sent, passes Odoo's native confirmation error check, and its relevant fields match the admitted snapshot.",
          "resolver": "odoo_native_transition"
        },
        {
          "id": "request_identity_matches_order",
          "observation": "Customer, product, quantity and task reference match the admitted task request. Price and deadline are checked separately.",
          "resolver": "deterministic_field_match"
        },
        {
          "id": "commercial_terms_match_policy",
          "observation": "Unit price is list price, untaxed total is within budget, and any required sales payment term matches registered semantics.",
          "resolver": "deterministic_arithmetic"
        },
        {
          "id": "commitment_is_feasible",
          "observation": "The commitment date is within the request deadline and shared portfolio_plan_valid provides an on-time supply path.",
          "resolver": "deterministic_date_check"
        }
      ],
      "requires_shared": ["portfolio_plan_valid", "lineage_closure_valid"]
    },
    {
      "id": "purchase_order_release.v1",
      "executor_status": "planned",
      "protects": ["purchase.order.button_confirm"],
      "applicable_stages": ["release", "replacement_release"],
      "required_payload_fields": ["state", "vendor_ref", "product_code", "quantity", "unit_cost", "planned_arrival_days", "origin_refs"],
      "decision": "ALL_APPLICABLE",
      "checks": [
        {
          "id": "target_is_unique_fresh_draft_po",
          "observation": "The RFQ exists once, remains draft/sent, passes Odoo's native confirmation check, and its relevant fields match the admitted snapshot.",
          "resolver": "odoo_native_transition"
        },
        {
          "id": "vendor_offer_is_allowed",
          "observation": "Vendor, product and route resolve to an admitted offer and are not forbidden or disrupted.",
          "resolver": "deterministic_field_match"
        },
        {
          "id": "quantity_and_price_match_tier",
          "observation": "Horizon-wide quantity respects min/max/vendor-note caps and unit price equals the applicable offer tier.",
          "resolver": "deterministic_arithmetic"
        },
        {
          "id": "delivery_date_is_feasible",
          "observation": "Planned receipt is no earlier than vendor lead time and no later than every linked consumer need date.",
          "resolver": "deterministic_date_check"
        },
        {
          "id": "replacement_avoids_broken_path",
          "applicable_stages": ["replacement_release"],
          "observation": "No replacement PO/MO resolves to the broken supplier offer or workcenter.",
          "resolver": "deterministic_supply_graph"
        }
      ],
      "requires_shared": ["portfolio_plan_valid", "lineage_closure_valid"],
      "stage_prerequisites": {
        "replacement_release": [
          {
            "template_id": "cancel_and_repair_supply.v1",
            "stage": "cancel",
            "required_postconditions": ["disrupted_commitment_is_cancelled"]
          }
        ]
      }
    },
    {
      "id": "manufacturing_order_release.v1",
      "executor_status": "planned",
      "protects": ["mrp.production.action_confirm"],
      "applicable_stages": ["release"],
      "required_payload_fields": ["state", "product_code", "bom_ref", "quantity", "workcenter_code", "planned_start_days", "planned_due_days", "origin_refs"],
      "decision": "ALL_APPLICABLE",
      "checks": [
        {
          "id": "target_is_unique_fresh_draft_mo",
          "observation": "The manufacturing order exists once, remains draft, and its relevant fields match the admitted snapshot.",
          "resolver": "odoo_snapshot"
        },
        {
          "id": "bom_route_and_quantity_are_allowed",
          "observation": "Product, BOM, quantity and manufacture route are admitted and do not use a forbidden finished-goods route.",
          "resolver": "deterministic_bom_graph"
        },
        {
          "id": "planned_workcenter_assignment_is_feasible",
          "observation": "The proposal's BOM operation/workcenter assignment is qualified and its horizon minutes fit admitted capacity; workorders need not exist before MO confirmation.",
          "resolver": "deterministic_capacity_check"
        },
        {
          "id": "manufacturing_dates_are_feasible",
          "observation": "Proposed start, lead-time and due dates fit every linked sales-order deadline.",
          "resolver": "deterministic_date_check"
        },
        {
          "id": "component_closure_is_feasible",
          "observation": "On-hand and linked component POs/MOs cover the transitive BOM quantities before production starts.",
          "resolver": "deterministic_bom_graph"
        }
      ],
      "requires_shared": ["portfolio_plan_valid", "lineage_closure_valid"],
      "post_action_checks": [
        {
          "id": "actual_workorders_match_planned_assignment",
          "observation": "After confirmation, generated workorders match the authorized workcenter assignment and capacity plan.",
          "resolver": "odoo_snapshot"
        }
      ],
      "postconditions_for_shared": {
        "supply_plan_released_checkpoint": ["actual_workorders_match_planned_assignment"]
      }
    },
    {
      "id": "customer_invoice_post.v1",
      "executor_status": "planned",
      "protects": ["account.move.action_post"],
      "applicable_stages": ["downpayment", "regular", "balance"],
      "required_payload_fields": ["state", "invoice_role", "order_ref", "customer_ref", "amount_untaxed", "payment_term", "tax_basis", "currency"],
      "decision": "ALL_APPLICABLE",
      "checks": [
        {
          "id": "target_is_unique_fresh_draft_customer_invoice",
          "observation": "The exact account.move exists once, is a draft out_invoice, and state, move_type, partner, terms, amounts, taxes, lines, SO lineage and write_date match the admitted snapshot.",
          "resolver": "odoo_snapshot"
        },
        {
          "id": "invoice_is_natively_postable",
          "observation": "Posting rights and Odoo-native required journal, company, currency, date, partner, active accounts and balanced non-empty lines are valid; no known posting blocker is present.",
          "resolver": "odoo_native_transition"
        },
        {
          "id": "invoice_identity_and_lineage_match_order",
          "observation": "Invoice partner and lines link exactly to the intended retained confirmed sale order under the same proposal.",
          "resolver": "deterministic_lineage_graph"
        },
        {
          "id": "payment_term_matches_policy",
          "observation": "Sale order and invoice use the registered payment-term semantics, not only a coincidentally similar label.",
          "resolver": "deterministic_field_match"
        },
        {
          "id": "invoice_stage_preconditions_hold",
          "observation": "Regular-only posts once. A down payment posts before the balance. A regular balance requires the authorized down-payment checkpoint and no unexpected invoice role. Future stages need not already exist.",
          "resolver": "deterministic_invoice_flow"
        },
        {
          "id": "invoice_amount_matches_mode_and_value",
          "observation": "Inputs are threshold, mode=fixed_amount|percentage, value and currency tolerance. regular_only expects the full SO untaxed total; downpayment computes the configured fixed or percentage amount independently; balance expects SO untaxed total minus the authorized down payment. Each invoice must match its own stage.",
          "resolver": "deterministic_arithmetic"
        },
        {
          "id": "invoice_taxes_match_odoo_computation",
          "observation": "Draft invoice taxes and totals match admitted SO lines, product taxes and fiscal position. Tax-free is required only by explicit public policy, never inferred from a pre-tax budget or hidden verifier.",
          "resolver": "deterministic_arithmetic"
        },
        {
          "id": "invoice_scope_is_exact",
          "observation": "Only retained orders are invoice targets, and the proposal schedules exactly the registered invoice stages for each retained order.",
          "resolver": "deterministic_set_comparison"
        }
      ],
      "requires_shared": ["supply_plan_released_checkpoint"],
      "stage_prerequisites": {
        "balance": [
          {"template_id": "customer_invoice_post.v1", "stage": "downpayment"}
        ]
      }
    },
    {
      "id": "cancel_and_repair_supply.v1",
      "executor_status": "active",
      "protects": ["purchase.order.button_cancel", "mrp.production.action_cancel"],
      "applicable_stages": ["cancel"],
      "required_payload_fields": {
        "purchase.order.button_cancel": ["state", "vendor_ref", "product_code", "quantity", "unit_cost", "planned_arrival_days", "origin_refs"],
        "mrp.production.action_cancel": ["state", "product_code", "bom_ref", "quantity", "workcenter_code", "planned_start_days", "planned_due_days", "origin_refs"]
      },
      "decision": "ALL_APPLICABLE",
      "checks": [
        {
          "id": "target_is_exact_disrupted_commitment",
          "observation": "The cancellation target is the admitted broken PO/MO and the disruption evidence identifies the same vendor offer or workcenter.",
          "resolver": "deterministic_field_match"
        },
        {
          "id": "target_is_fresh_and_natively_cancellable",
          "observation": "Branch by target_model. PO: unchanged, unlocked, and no non-draft/non-cancelled vendor bill. MO: unchanged and not done. Any stricter completed-receipt/consumption rule is registered business safety policy, not Odoo-native behavior.",
          "resolver": "odoo_native_transition"
        },
        {
          "id": "cancellation_scope_is_exact",
          "observation": "Only commitments affected by the admitted disruption are cancelled; unaffected task commitments are not cancellation targets.",
          "resolver": "deterministic_set_comparison"
        }
      ],
      "requires_shared": [],
      "post_action_checks": [
        {
          "id": "disrupted_commitment_is_cancelled",
          "observation": "After cancellation, the exact broken PO/MO is cancelled and the bound replacement proposal remains current.",
          "resolver": "odoo_snapshot"
        }
      ]
    }
  ]
}
