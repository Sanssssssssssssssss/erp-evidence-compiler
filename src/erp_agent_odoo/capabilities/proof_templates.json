{
  "schema_version": 7,
  "execution_contract": {
    "compiler_output": "checks, dependencies, parameters, source selectors and action DAG only",
    "authorization_binding": ["proposal_hash", "source_snapshot_hash", "policy_hash"],
    "freshness": "Recompute all three hashes and referenced record revisions immediately before each protected action; any mismatch is STALE and blocks execution.",
    "composition": "Merge identical checks by check id, normalized parameters and source snapshot hash into one shared DAG node.",
    "executor": "one logical batched invocation over the dependency-closed DAG per child revision",
    "fine_verifier": "one logical batched invocation over the same DAG per child revision",
    "kernel": "deterministic replay",
    "missing_evidence": "BLOCK",
    "stale_evidence": "BLOCK",
    "model_fallback": "only for admitted but genuinely semantic evidence"
  },
  "proof_recipes": {
    "portfolio_plan_valid": {
      "resolver": "deterministic_supply_graph",
      "evidence": [
        {"group_id": "proposal_graph", "source": "MANAGER_PROPOSAL", "method": "STRUCTURED", "facts": ["actions", "targets", "stages", "record_values", "origin_refs"]},
        {"group_id": "planning_policy", "source": "BOUND_SOURCE", "source_role": "instruction", "method": "MODEL_QUOTE", "facts": ["objective", "allowed_routes", "consolidation", "quantity_tiers", "margin_rule", "date_rules"]},
        {"group_id": "planning_facts", "source": "BOUND_SOURCE", "source_role": "evidence", "method": "READ_AND_EXTRACT", "facts": ["demand", "stock", "offers", "boms", "workcenters", "lead_times", "relevant_internal_notes"]}
      ]
    },
    "lineage_closure_valid": {
      "resolver": "deterministic_lineage_graph",
      "evidence": [
        {"group_id": "proposal_lineage", "source": "MANAGER_PROPOSAL", "method": "STRUCTURED", "facts": ["actions", "targets", "origin_refs"]},
        {"group_id": "business_identities", "source": "BOUND_SOURCE", "source_role": "evidence", "method": "READ_AND_EXTRACT", "facts": ["sales_requests", "purchase_offers", "manufacturing_inputs"]}
      ]
    },
    "supply_plan_released_checkpoint": {
      "resolver": "odoo_snapshot",
      "evidence": [
        {"group_id": "authorized_actions", "source": "MANAGER_PROPOSAL", "method": "STRUCTURED", "facts": ["actions", "targets", "record_revisions"]},
        {"group_id": "live_release_state", "source": "LIVE_ODOO", "method": "RUNTIME_TOOL", "facts": ["record_refs", "state", "write_date", "origin_refs", "release_postconditions"]}
      ]
    },
    "target_is_unique_fresh_reviewable_so": {
      "resolver": "odoo_snapshot",
      "evidence": [
        {"group_id": "authorized_target", "source": "MANAGER_PROPOSAL", "method": "STRUCTURED", "facts": ["record_ref", "record_revision", "state", "customer_ref", "product_code", "quantity", "price_unit", "commitment_days"]},
        {"group_id": "live_target", "source": "LIVE_ODOO", "method": "RUNTIME_TOOL", "facts": ["record_ref", "write_date", "state", "customer_ref", "order_lines", "commitment_date"]}
      ]
    },
    "request_identity_matches_order": {
      "resolver": "deterministic_field_match",
      "evidence": [
        {"group_id": "proposed_order", "source": "MANAGER_PROPOSAL", "method": "STRUCTURED", "facts": ["customer_ref", "product_code", "quantity", "task_ref"]},
        {"group_id": "task_request", "source": "BOUND_SOURCE", "source_role": "evidence", "method": "READ_AND_EXTRACT", "facts": ["customer_ref", "product_code", "quantity", "task_ref"]}
      ]
    },
    "acceptance_policy_is_admitted": {
      "resolver": "registered_policy",
      "evidence": [
        {"group_id": "policy_text", "source": "BOUND_SOURCE", "source_role": "instruction", "method": "MODEL_QUOTE", "facts": ["active_predicate_ids", "predicate_parameters", "policy_scope"]}
      ]
    },
    "acceptance_predicates_match_requested_action": {
      "resolver": "deterministic_arithmetic",
      "evidence": [
        {"group_id": "proposed_order", "source": "MANAGER_PROPOSAL", "method": "STRUCTURED", "facts": ["action_kind", "quantity", "price_unit", "commitment_days"]},
        {"group_id": "acceptance_policy", "source": "BOUND_SOURCE", "source_role": "instruction", "method": "MODEL_QUOTE", "facts": ["budget_rule", "min_quantity", "max_quantity", "min_lead_days", "list_price"]},
        {"group_id": "customer_request", "source": "BOUND_SOURCE", "source_role": "evidence", "method": "READ_AND_EXTRACT", "facts": ["budget", "requested_quantity", "requested_lead_days"]}
      ]
    },
    "proposal_matches_policy_outcome": {
      "resolver": "deterministic_set_comparison",
      "evidence": [
        {"group_id": "proposed_targets", "source": "MANAGER_PROPOSAL", "method": "STRUCTURED", "facts": ["confirm_targets", "cancel_targets", "create_targets"]},
        {"group_id": "candidate_requests", "source": "BOUND_SOURCE", "source_role": "evidence", "method": "READ_AND_EXTRACT", "facts": ["seeded_requests", "prompt_requests"]},
        {"group_id": "predicate_results", "source": "UPSTREAM_CHECK", "method": "UPSTREAM", "upstream_checks": ["acceptance_predicates_match_requested_action"], "facts": ["per_request_acceptance"]}
      ]
    },
    "confirm_payload_and_supply_are_valid": {
